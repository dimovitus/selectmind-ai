{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/application/*": ["packages/core/src/application/*"],
      "@/domain/*": ["packages/core/src/domain/*"],
      "@/infrastructure/ai/*": ["packages/core/src/ai/*"],
      "@/shared/*": ["packages/shared/src/*"],
      "@selectmind/core": ["packages/core/src/index.ts"],
      "@selectmind/shared": ["packages/shared/src/index.ts"]
    },
    "types": ["chrome", "vite/client"]
  },
  "include": ["src", "packages/core/src", "packages/shared/src", "tests/unit"],
  "exclude": ["apps/**", "dist", "node_modules"]
}
